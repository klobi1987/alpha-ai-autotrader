# Alpha AI Autotrader - Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== APPLICATION ====================
APP_NAME=Alpha AI Autotrader
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secret-key-here-change-this-in-production

# ==================== DATABASE ====================
DATABASE_URL=sqlite+aiosqlite:///./data/alpha_autotrader.db

# ==================== LUNARCRUSH API ====================
LUNARCRUSH_API_KEY=your_lunarcrush_api_key_here
LUNARCRUSH_CACHE_TTL=300  # 5 minutes

# ==================== MEXC API ====================
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET_KEY=your_mexc_secret_key_here
MEXC_TESTNET=false

# ==================== AI MODELS ====================

# Anthropic Claude (REQUIRED - Main AI Brain)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Get your Claude Max subscription API key from: https://console.anthropic.com/

# OpenRouter (Optional - for multi-AI consensus)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary AI Model (default: DeepSeek R1)
PRIMARY_AI_MODEL=deepseek/deepseek-r1
# Options: deepseek/deepseek-r1, google/gemini-2.0-flash-thinking-exp, qwen/qwen-2.5-coder-32b-instruct

# Secondary AI Model (for consensus)
SECONDARY_AI_MODEL=google/gemini-2.0-flash-thinking-exp

# ==================== TRADING SETTINGS ====================
TRADING_MODE=testing  # testing or live
MAX_POSITION_SIZE_USD=500
MAX_CONCURRENT_POSITIONS=3
MAX_LEVERAGE=5
STOP_LOSS_PERCENT=2.0
MIN_CONFIDENCE_SCORE=7.5

# ==================== RISK MANAGEMENT ====================
MAX_PORTFOLIO_RISK_PERCENT=10.0
POSITION_SIZE_METHOD=fixed  # fixed, kelly, volatility
ENABLE_DYNAMIC_STOP_LOSS=true
ENABLE_BREAK_EVEN_MOVE=true
BREAK_EVEN_PROFIT_THRESHOLD=5.0  # Move SL to BE at +5% profit

# ==================== AI FEATURES ====================
ENABLE_MULTI_AI_CONSENSUS=true
CONSENSUS_MIN_VOTES=2  # Minimum AI models that must agree
ENABLE_WEB_SURFING=true
WEB_SURFING_THRESHOLD=8.0  # Surf web for signals >8.0 confidence
ENABLE_PATTERN_DISCOVERY=true
PATTERN_DISCOVERY_INTERVAL=604800  # 7 days

# ==================== MARKET SCANNING ====================
SCAN_INTERVAL=300  # 5 minutes
TOP_COINS_TO_SCAN=100
MIN_MARKET_CAP=10000000  # $10M minimum
MIN_VOLUME_24H=1000000  # $1M minimum

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=logs/alpha_autotrader.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ==================== NOTIFICATIONS (Optional) ====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_ALERTS=false

DISCORD_WEBHOOK_URL=
ENABLE_DISCORD_ALERTS=false

# ==================== ADVANCED ====================
ENABLE_WEBSOCKET=true
ENABLE_AUTO_TRADING=false  # IMPORTANT: Set to true only after testing
ENABLE_FUTURES_TRADING=true
ENABLE_SPOT_TRADING=true
ENABLE_PAPER_TRADING=true  # Simulate trades without real execution

# Shared cache (for multiple projects)
SHARED_CACHE_DIR=/shared/cache
ENABLE_SHARED_CACHE=false
